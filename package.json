{
  "name": "clawnet-cybersecurity",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "preview": "vite preview",
    "test": "npm run test:engine",
    "format": "prettier --write \"src/**/*.{js,jsx,json,css,md}\"",
    "format:check": "prettier --check \"src/**/*.{js,jsx,json,css,md}\"",
    "security:audit": "npm audit",
    "prepare": "husky install || true",
    "test:engine": "node --test \"clawnet/test/unit/**/*.test.js\" \"clawnet/test/integration/**/*.test.js\" \"clawnet/test/e2e/**/*.test.js\"",
    "test:engine:unit": "node --test \"clawnet/test/unit/**/*.test.js\"",
    "clawnet": "node clawnet/bin/clawnet.js"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.80.0",
    "@tailwindcss/typography": "^0.5.19",
    "framer-motion": "^11.15.0",
    "lucide-react": "^0.511.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-hot-toast": "^2.6.0",
    "react-router-dom": "^7.9.5"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.1.0",
    "autoprefixer": "^10.4.19",
    "eslint": "^8.57.1",
    "eslint-plugin-react": "^7.34.4",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-react-refresh": "^0.4.7",
    "globals": "^15.9.0",
    "husky": "^9.1.6",
    "postcss": "^8.4.39",
    "tailwindcss": "^3.4.6",
    "vite": "^7.2.2"
  },
  "engines": {
    "node": ">=22.12"
  },
  "overrides": {
    "@tailwindcss/typography": {
      "postcss-selector-parser": "^6.1.6"
    }
  }
}
